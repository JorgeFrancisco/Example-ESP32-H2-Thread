# ESP-IDF build output
build/
# A/B build directories (idf.py -B build_<variant>)
build_*/
sdkconfig.old

# Managed components (restored from dependencies.lock on build)
managed_components/

# Local editor/tool settings (machine-specific paths and serial port)
.vscode/
.cache/

# Logs
*.log

# esp-matter-mfg-tool output (per-board factory data with private keys)
out/

# Generated by idf.py from sdkconfig.defaults (do not track)
/sdkconfig
