#
# Target: ESP32-H2 only (Thread + Bluetooth LE)
#
CONFIG_IDF_TARGET="esp32h2"

#
# Flash: the ESP32-H2-DevKitM-1 (ESP32-H2-MINI-1) has 4 MB
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#
# Partition table: two OTA slots plus the Matter factory partitions
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

#
# Bluetooth LE: only used during commissioning
#
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Minimal NimBLE for a Matter over Thread device: BLE is only used to carry
# CHIPoBLE (BTP) during commissioning, so the device is peripheral-only and
# never scans, connects out, or pairs. Matter secures the session with PASE,
# not with BLE bonding, and CHIPoBLE advertises with a static random address
# (ble_hs_id_gen_rnd(0, ...)) instead of a resolvable private address, so the
# host privacy/RPA code is unreachable here as well. Disabling the central
# role also drops CONFIG_BT_NIMBLE_GATT_CLIENT, and disabling security drops
# the SMP/bonding subtree together with its TinyCrypt dependency.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_CODED_PHY=n
CONFIG_BT_NIMBLE_HS_PVCY=n

#
# OpenThread (Full Thread Device: a mains-powered relay can be a Thread router)
#
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=n

#
# lwIP for OpenThread
#
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

#
# Matter
#
# No Wi-Fi on the ESP32-H2
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_USE_MINIMAL_MDNS=n

CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_MBEDTLS_HKDF_C=y

# Root node (endpoint 0) and the relay (endpoint 1)
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2

# Commissioning data, device attestation and device info (vendor/product
# names, VID/PID) come from the factory partition generated with
# esp-matter-mfg-tool and flashed to the "fctry" partition (see README).
CONFIG_ENABLE_TEST_SETUP_PARAMS=n
CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=y
CONFIG_ENABLE_ESP32_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_FACTORY_PARTITION_DAC_PROVIDER=y
CONFIG_FACTORY_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_FACTORY_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="fctry"

#
# Clusters not used by an On/Off Plug-in Unit (saves flash and RAM)
# (list taken from the esp-matter light example)
#
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
